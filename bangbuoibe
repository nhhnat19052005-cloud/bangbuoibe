local function getMyHousePosition()
    local myName = player.Name:lower()
    local myPenPart = nil
    local myPenModel = nil

    -- 1. Tìm Pen của mình trước
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name:lower()
            if n:find("pen") then
                local isMine = false
                if n:find(myName) or n:find(tostring(player.UserId)) then isMine = true end
                
                local ownerId = obj:GetAttribute("OwnerId") or obj:GetAttribute("UserId") or obj:GetAttribute("Owner")
                if ownerId == player.UserId or ownerId == player.Name then isMine = true end
                
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("ObjectValue") and d.Value == player then isMine = true end
                    if d:IsA("StringValue") and d.Value == player.Name then isMine = true end
                end

                if isMine then
                    myPenModel = obj.Parent
                    myPenPart = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    break
                end
            end
        end
    end

    -- 2. Nếu tìm thấy Pen, đi tìm Collect Zone gần Pen đó
    if myPenPart then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and (obj.Name:lower():find("collect") or obj.Name:lower():find("safe")) then
                local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    -- Check xem Collect Zone có nằm gần Pen mình không (bán kính 50 studs)
                    if (part.Position - myPenPart.Position).Magnitude < 50 then
                        return part.Position
                    end
                    -- Hoặc check xem nó có nằm chung Model với Pen mình không
                    if obj:IsDescendantOf(myPenModel) or myPenPart:IsDescendantOf(obj) then
                        return part.Position
                    end
                end
            end
        end
        -- Nếu không thấy Collect Zone, trả về vị trí Pen
        return myPenPart.Position
    end

    return nil
end

local function isFakeEggChar(char)
    if not char then return false end
    if char:FindFirstChildWhichIsA("ProximityPrompt", true) then return true end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BillboardGui") then
            for _, txt in ipairs(v:GetDescendants()) do
                if txt:IsA("TextLabel") then
                    local text = txt.Text:lower()
                    if text:find("%$") or text:find("egg") or text:find("trứng") or text:find("common") or text:find("rare") or text:find("epic") or text:find("legendary") or text:find("mythic") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function DoTween()
    if not S.SavedPos or S.isTweening then return end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    S.isTweening = true
    local startPos = root.Position
    task.spawn(function()
        for i = 1, 6 do
            local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not r then break end
            r.CFrame = CFrame.new(startPos:Lerp(S.SavedPos, i / 6))
            task.wait(0.016)
        end
        S.isTweening = false
    end)
end

