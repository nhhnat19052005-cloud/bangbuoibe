local function addNeonBorder(targetFrame, thickness)
    local borderFrame = Instance.new("Frame")
    borderFrame.Name = "NeonBorder"
    borderFrame.Size = UDim2.new(1, thickness*2, 1, thickness*2)
    borderFrame.Position = UDim2.new(0, -thickness, 0, -thickness)
    borderFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    borderFrame.BackgroundTransparency = 0
    borderFrame.BorderSizePixel = 0
    borderFrame.ZIndex = targetFrame.ZIndex - 1
    borderFrame.Parent = targetFrame.Parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = borderFrame
    
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 128)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 128)),
    }
    grad.Parent = borderFrame
    table.insert(STATE.ActiveGradients, grad)
    
    local function update()
        borderFrame.Size = UDim2.new(1, thickness*2, 1, thickness*2)
        borderFrame.Position = UDim2.new(0, -thickness, 0, -thickness)
        local targetCorner = targetFrame:FindFirstChildOfClass("UICorner")
        if targetCorner then corner.CornerRadius = targetCorner.CornerRadius end
    end
    targetFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
    if targetFrame:FindFirstChildOfClass("UICorner") then
        targetFrame:FindFirstChildOfClass("UICorner"):GetPropertyChangedSignal("CornerRadius"):Connect(update)
    end
    update()
    return borderFrame
end

