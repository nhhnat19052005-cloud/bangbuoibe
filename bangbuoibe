            local servers = {}
            local okt, result = pcall(function()
                local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
                return HttpService:JSONDecode(game:HttpGet(url))
            end)
            if okt and result and result.data then
                for _, sv in ipairs(result.data) do
                    if sv.playing >= 2 and sv.playing < sv.maxPlayers then
                        table.insert(servers, sv)
                    end
                end
            end
            return servers
        end
        task.spawn(function()
            local availableServers = getServers(game.PlaceId)
            if #availableServers == 0 then
                btnHop.Text = "❌ HẾT SERVER ĐÔNG!"
                task.delay(2, function() btnHop.Text = "🌐 HOP SERVER NGẪU NHIÊN" end)
                return
            end
            btnHop.Text = "⏳ ĐANG QUÉT BẠN BÈ..."
            local friendsOnline = {}
            pcall(function()
                local pages = Players:GetFriendsAsync(player.UserId)
                while true do
                    local currentPage = pages:GetCurrentPage()
                    for _, item in ipairs(currentPage) do if item.IsOnline then friendsOnline[item.Id] = true end end
                    if pages.IsFinished then break end
                    pages:AdvanceToNextPageAsync()
                end
            end)
            local chosenServer = nil
            local fallbackServer = availableServers[1].id
            for _, sv in ipairs(availableServers) do
                local hasFriend = false
                pcall(function()
                    local checkUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/" .. sv.id
                    local checkData = HttpService:JSONDecode(game:HttpGet(checkUrl))
                    for _, p in ipairs(checkData.data) do if friendsOnline[p.id] then hasFriend = true; break end end
                end)
                if not hasFriend then chosenServer = sv.id; break end
            end
            if chosenServer then
                btnHop.Text = "⏳ ĐANG CHUYỂN..."
                TeleportService:TeleportToPlaceInstance(game.PlaceId, chosenServer, player)
            elseif fallbackServer then
                btnHop.Text = "⏳ CHUYỂN NGẪU NHIÊN..."
                TeleportService:TeleportToPlaceInstance(game.PlaceId, fallbackServer, player)
            else
                btnHop.Text = "❌ LỖI HOP!"
                task.delay(2, function() btnHop.Text = "🌐 HOP SERVER NGẪU NHIÊN" end)
            end
        end)
