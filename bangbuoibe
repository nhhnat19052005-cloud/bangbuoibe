print("[ollie] Bước 6: FloatAndWalkBack")
local function FloatAndWalkBack(tag)
    print("[PW] START tag=", tostring(tag))
    if S.isMoving then print("[PW] moving, skip"); return end
    if not S.SavedPos then warn("[PW] no SavedPos"); return end
    local c = player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not r or not h then print("[PW] no root/hum"); return end

    S.isMoving = true
    local targetPos = S.SavedPos
    local oldSpeed = h.WalkSpeed
    local startY = r.Position.Y

    h.Jump = true
    task.wait(0.15)
    if r.Position.Y - startY < 2 then
        r.CFrame = r.CFrame + Vector3.new(0, 5, 0)
        print("[PW] force CFrame up")
    end
    task.wait(0.1)
    local airY = r.Position.Y

    local LIFT = 13
    local board = Instance.new("Part")
    board.Name = "OllieFloatBoard"
    board.Size = Vector3.new(8, 1, 8)
    board.Anchored = true
    board.CanCollide = true
    board.Transparency = 0.3
    board.Material = Enum.Material.ForceField
    board.Color = Color3.fromRGB(255, 0, 255)
    board.CFrame = CFrame.new(r.Position.X, airY + LIFT - 3.5, r.Position.Z)
    board.Parent = Workspace
    print("[PW] board Y=", board.Position.Y, " (+"..LIFT..")")

    local boardTopY = board.Position.Y + 0.5
    local desiredRootY = boardTopY + 3
    r.CFrame = CFrame.new(r.Position.X, desiredRootY, r.Position.Z)
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    h.WalkSpeed = 33
    h:ChangeState(Enum.HumanoidStateType.Running)

    local hue = 0
    local rgbConn
    rgbConn = RunService.Heartbeat:Connect(function(dt)
        if not board or not board.Parent then
            if rgbConn then rgbConn:Disconnect() end
            return
        end
        hue = (hue + dt * 0.8) % 1
        board.Color = Color3.fromHSV(hue, 1, 1)
    end)

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not r or not r.Parent or not h or h.Health <= 0 or not S.isMoving then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            if h then h.WalkSpeed = oldSpeed end
            S.isMoving = false
            return
        end

        if h.MoveDirection.Magnitude > 0.8 then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            h.WalkSpeed = oldSpeed
            S.isMoving = false
            return
        end

        local distXZ = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(r.Position.X, 0, r.Position.Z)).Magnitude
        if distXZ < 5 then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            h.WalkSpeed = oldSpeed
            S.isMoving = false
            return
        end

        h:MoveTo(Vector3.new(targetPos.X, r.Position.Y, targetPos.Z))

        if math.abs(r.Position.Y - desiredRootY) > 0.3 then
            r.CFrame = CFrame.new(r.Position.X, desiredRootY, r.Position.Z)
            r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, 0, r.AssemblyLinearVelocity.Z)
        end

        board.CFrame = CFrame.new(r.Position.X, board.Position.Y, r.Position.Z)
    end)
end

print("[ollie] Bước 7: TurboTween 0.1s")
local function TurboTween()
    if not S.SavedPos then warn("[TURBO] no SavedPos"); return end
    if S.isMoving then print("[TURBO] đang moving, skip"); return end
    local c = player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    S.isMoving = true
    local targetCF = CFrame.new(S.SavedPos)
    local tw = TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local t = TweenService:Create(r, tw, {CFrame = targetCF})
    t:Play()
    t.Completed:Connect(function()
        S.isMoving = false
        print("[TURBO] Done")
    end)
    task.delay(0.3, function() S.isMoving = false end)
end

print("[ollie] Bước 8: fly")
local flyConn = nil
local flyKeys = {W=false,A=false,S=false,D=false,Q=false,E=false}
local flyTouch = Vector2.new(0,0)

local function stopFly()
    S.flyEnabled = false
    if flyConn then flyConn:Disconnect(); flyConn = nil end
end

local function startFly()
    stopFly()
    local c = player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    S.flyEnabled = true
    flyConn = RunService.RenderStepped:Connect(function()
        if not S.flyEnabled then return end
        local ch = player.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        if not rt then return end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        local spd = S.flySpeed
        if flyKeys.W then dir = dir + cam.CFrame.LookVector end
        if flyKeys.S then dir = dir - cam.CFrame.LookVector end
        if flyKeys.A then dir = dir - cam.CFrame.RightVector end
        if flyKeys.D then dir = dir + cam.CFrame.RightVector end
        if flyKeys.E then dir = dir + Vector3.new(0,1,0) end
        if flyKeys.Q then dir = dir - Vector3.new(0,1,0) end
        if IS_MOBILE and flyTouch.Magnitude > 0.05 then
            dir = dir + cam.CFrame.RightVector * flyTouch.X
            dir = dir - cam.CFrame.LookVector * flyTouch.Y
        end
        if dir.Magnitude > 0 then
            rt.CFrame = rt.CFrame + dir.Unit * (spd / 60)
        end
        rt.AssemblyLinearVelocity = Vector3.zero
        rt.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local k = input.KeyCode
    if k == Enum.KeyCode.W then flyKeys.W = true
    elseif k == Enum.KeyCode.A then flyKeys.A = true
    elseif k == Enum.KeyCode.S then flyKeys.S = true
    elseif k == Enum.KeyCode.D then flyKeys.D = true
    elseif k == Enum.KeyCode.Q then flyKeys.Q = true
    elseif k == Enum.KeyCode.E then flyKeys.E = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    local k = input.KeyCode
    if k == Enum.KeyCode.W then flyKeys.W = false
    elseif k == Enum.KeyCode.A then flyKeys.A = false
    elseif k == Enum.KeyCode.S then flyKeys.S = false
    elseif k == Enum.KeyCode.D then flyKeys.D = false
    elseif k == Enum.KeyCode.Q then flyKeys.Q = false
    elseif k == Enum.KeyCode.E then flyKeys.E = false
    end
end)

if IS_MOBILE then
    RunService.RenderStepped:Connect(function()
        if not S.flyEnabled then return end
        local c = player.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local md = hum.MoveDirection
        if md.Magnitude > 0.05 then
            local cam = workspace.CurrentCamera
            flyTouch = Vector2.new(md:Dot(cam.CFrame.RightVector), -(md:Dot(cam.CFrame.LookVector)))
        else
            flyTouch = Vector2.new(0, 0)
        end
    end)
end

