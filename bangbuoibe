local function doRainbowTween(targetCFrame)
    if STATE.Tweening then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    STATE.Tweening = true
    hrp.Anchored = true
    local oldWS, oldJP = hum.WalkSpeed, hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    
    local rainbowBox = Instance.new("Highlight")
    rainbowBox.Parent = char
    rainbowBox.Adornee = char
    rainbowBox.FillTransparency = 0.5
    rainbowBox.OutlineTransparency = 0
    local colorTask = task.spawn(function()
        while STATE.Tweening do
            rainbowBox.FillColor = Color3.fromHSV(tick() % 1, 1, 1)
            rainbowBox.OutlineColor = Color3.fromHSV((tick() + 0.5) % 1, 1, 1)
            RunService.RenderStepped:Wait()
        end
    end)
    
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    tween.Completed:Connect(function()
        if hrp and hrp.Parent then hrp.Anchored = false end
        if hum and hum.Parent then
            hum.WalkSpeed = CONFIG.WalkSpeed
            hum.JumpPower = oldJP
        end
        STATE.Tweening = false
        if rainbowBox then rainbowBox:Destroy() end
        task.cancel(colorTask)
    end)
end

local function triggerTurbo()
    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        STATE.OriginalPos = char.HumanoidRootPart.CFrame
        doRainbowTween(CFrame.new(CONFIG.SavedPos))
    end
end

local function triggerBack()
    if STATE.OriginalPos then doRainbowTween(STATE.OriginalPos) end
end

local function applyAntiRagdoll()
    if not CONFIG.AntiRagdoll or STATE.Tweening then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp then
        local state = hum:GetState()
        if hum.PlatformStand or hum.Sit or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
            hum.PlatformStand = false
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hrp.Anchored = true
            task.delay(0.1, function()
                if hrp and hrp.Parent then hrp.Anchored = false end
            end)
        end
    end
end

local function applyInstantPrompt()
    if not CONFIG.InstantPrompt then return end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
    end
end

Workspace.DescendantAdded:Connect(function(v)
    if CONFIG.InstantPrompt and v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
end)

local function applyFPSBoost()
    if not CONFIG.FPSBoost then return end
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1000000
        Lighting.Brightness = 1
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") then v:Destroy() end
        end
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            elseif v:IsA("Trail") or v:IsA("Beam") then
                v.Enabled = false
            elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                v.Enabled = false
            end
        end
    end)
end

Workspace.DescendantAdded:Connect(function(inst)
    if CONFIG.FPSBoost then
        if inst:IsA("ParticleEmitter") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
            inst.Enabled = false
        end
    end
end)

