local function HookPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if prompt:GetAttribute("OllieHooked") then return end
    prompt:SetAttribute("OllieHooked", true)

    prompt.Triggered:Connect(function(plr)
        if plr ~= player then return end
        local act = string.lower(prompt.ActionText)
        if not S.autoTweenEnabled then return end

        local isBuy = act:find("buy") or act:find("mua")
        local isSteal = act:find("steal") or act:find("cướp")

        if isBuy then
            task.spawn(function() FloatAndWalkBack(act) end)
        elseif isSteal then
            task.spawn(TurboTween)
        end
    end)
end

