local frames = 0
local lastTime = tick()
local currentFps = 60
local currentPing = 0
local statUpdateTimer = 0

table.insert(STATE.Connections, RunService.RenderStepped:Connect(function(dt)
    if not STATE.Running then return end

    -- RGB UI
    local time = tick() * 100
    for i = #STATE.ActiveGradients, 1, -1 do
        local grad = STATE.ActiveGradients[i]
        if grad and grad.Parent then
            grad.Rotation = time % 360
        else
            table.remove(STATE.ActiveGradients, i)
        end
    end

    -- FPS/MS
    frames = frames + 1
    local now = tick()
    statUpdateTimer = statUpdateTimer + dt
    
    if now - lastTime >= 0.5 then
        currentFps = math.floor(frames / (now - lastTime))
        frames = 0
        lastTime = now
    end
    
    if statUpdateTimer >= 3 then
        statUpdateTimer = 0
        local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and ping then currentPing = math.floor(ping) else currentPing = math.floor(LP:GetNetworkPing() * 1000) end
    end
    
    if not STATE.UI_Open then
        local pingColor = currentPing < 80 and "150, 255, 150" or (currentPing < 150 and "255, 255, 150" or "255, 100, 100")
        statsLabel.Text = string.format("%d FPS | <font color='rgb(%s)'>%dms</font>", currentFps, pingColor, currentPing)
    end

    -- WalkSpeed & Ragdoll
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= CONFIG.WalkSpeed and not STATE.Tweening then
            hum.WalkSpeed = CONFIG.WalkSpeed
        end
    end

    pcall(applyAntiRagdoll)
    pcall(updateESP)
    if CONFIG.InstantPrompt and math.random() < 0.05 then pcall(applyInstantPrompt) end
end))

