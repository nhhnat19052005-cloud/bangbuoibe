print("[ollie] Bước 12: anti-ragdoll")
local lastValidCFrame = nil
local isFrozen = false
RunService.Heartbeat:Connect(function()
    if not S.ragdollEnabled then return end
    if S.isMoving then return end
    local c = player.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local rt = c:FindFirstChild("HumanoidRootPart")
    if not hum or not rt then return end
    if not isFrozen and not hum.PlatformStand and hum:GetState() ~= Enum.HumanoidStateType.Physics then
        lastValidCFrame = rt.CFrame
    end
    if hum.PlatformStand or hum:GetState() == Enum.HumanoidStateType.Physics then
        if not isFrozen and lastValidCFrame then
            isFrozen = true
            rt.Anchored = true
            task.spawn(function()
                local lockCFrame = CFrame.new(lastValidCFrame.Position, lastValidCFrame.Position + lastValidCFrame.LookVector)
                rt.CFrame = lockCFrame
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                local startTime = tick()
                while tick() - startTime < 0.5 do
                    if not rt or not rt.Parent then break end
                    rt.CFrame = lockCFrame
                    rt.Velocity = Vector3.zero
                    rt.RotVelocity = Vector3.zero
                    task.wait()
                end
                if rt and rt.Parent then
                    rt.Anchored = false
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
                isFrozen = false
            end)
        end
    end
end)

