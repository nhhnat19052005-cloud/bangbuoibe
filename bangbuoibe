-- ===== SNIPER LOGIC =====
local function getCash(plr)
    if plr == player then return 0 end
    local stats = plr:FindFirstChild("leaderstats")
    if not stats then return 0 end
    local cash = stats:FindFirstChild("Cash") or stats:FindFirstChild("Coins") or stats:FindFirstChild("Money")
    if not cash then return 0 end
    local val = cash.Value
    if type(val) == "number" then return val end
    if type(val) == "string" then
        local clean = string.gsub(val, "[^%d%.]", "")
        local num = tonumber(clean) or 0
        if string.find(string.upper(val), "T") then return num * 1e12 end
        if string.find(string.upper(val), "B") then return num * 1e9 end
        return num
    end
    return 0
end

local function formatMoney(val)
    if val >= 1e12 then return string.format("%.1fT", val / 1e12) end
    if val >= 1e9 then return string.format("%.1fB", val / 1e9) end
    if val >= 1e6 then return string.format("%.1fM", val / 1e6) end
    if val >= 1e3 then return string.format("%.1fK", val / 1e3) end
    return tostring(val)
end

print("[ollie] Bước 7: FloatAndWalkBack")
local function FloatAndWalkBack(tag)
    print("[PW] START tag=", tostring(tag))
    if S.isMoving then print("[PW] moving, skip"); return end
    if not S.SavedPos then warn("[PW] no SavedPos"); return end
    local c = player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not r or not h then print("[PW] no root/hum"); return end

    S.isMoving = true
    local targetPos = S.SavedPos
    local oldSpeed = h.WalkSpeed
    local startY = r.Position.Y
    local spinAngle = 0

    h.Jump = true
    task.wait(0.15)
    if r.Position.Y - startY < 2 then
        r.CFrame = r.CFrame + Vector3.new(0, 5, 0)
        print("[PW] force CFrame up")
    end
    task.wait(0.1)
    local airY = r.Position.Y

    local LIFT = 8
    local board = Instance.new("Part")
    board.Name = "OllieFloatBoard"
    board.Size = Vector3.new(8, 1, 8)
    board.Anchored = true
    board.CanCollide = true
    board.Transparency = 0
    board.Material = Enum.Material.Neon
    board.Color = Color3.fromRGB(255, 0, 255)
    board.CFrame = CFrame.new(r.Position.X, airY + LIFT - 3.5, r.Position.Z)
    board.Parent = Workspace
    print("[PW] board Y=", board.Position.Y, " (+"..LIFT..")")

    local boardTopY = board.Position.Y + 0.5
    local desiredRootY = boardTopY + 3
    r.CFrame = CFrame.new(r.Position.X, desiredRootY, r.Position.Z)
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    h.WalkSpeed = 30
    h:ChangeState(Enum.HumanoidStateType.Running)

    local hue = 0
    local rgbConn
    rgbConn = RunService.Heartbeat:Connect(function(dt)
        if not board or not board.Parent then
            if rgbConn then rgbConn:Disconnect() end
            return
        end
        hue = (hue + dt * 0.8) % 1
        board.Color = Color3.fromHSV(hue, 1, 1)
    end)

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not r or not r.Parent or not h or h.Health <= 0 or not S.isMoving then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            if h then h.WalkSpeed = oldSpeed end
            S.isMoving = false
            print("[PW] END die/stop")
            return
        end

        if h.MoveDirection.Magnitude > 0.8 then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            h.WalkSpeed = oldSpeed
            S.isMoving = false
            print("[PW] END override")
            return
        end

        local distXZ = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(r.Position.X, 0, r.Position.Z)).Magnitude
        if distXZ < 3 then
            if conn then conn:Disconnect() end
            if rgbConn then rgbConn:Disconnect() end
            if board and board.Parent then board:Destroy() end
            h.WalkSpeed = oldSpeed
            S.isMoving = false
            print("[PW] END arrived")
            return
        end

        h:MoveTo(Vector3.new(targetPos.X, r.Position.Y, targetPos.Z))
        r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, 0, r.AssemblyLinearVelocity.Z)
        if math.abs(r.Position.Y - desiredRootY) > 0.5 then
            r.CFrame = CFrame.new(r.Position.X, desiredRootY, r.Position.Z)
        end

        spinAngle = spinAngle + dt * 15
        board.CFrame = CFrame.new(r.Position.X, board.Position.Y, r.Position.Z) * CFrame.Angles(0, spinAngle, 0)
    end)
end

print("[ollie] Bước 8: TurboTween 0.1s")
local function TurboTween()
    if not S.SavedPos then warn("[TURBO] no SavedPos"); return end
    if S.isMoving then print("[TURBO] đang moving, skip"); return end
    local c = player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    S.isMoving = true
    local targetCF = CFrame.new(S.SavedPos)
    local tw = TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local t = TweenService:Create(r, tw, {CFrame = targetCF})
    t:Play()
    t.Completed:Connect(function()
        S.isMoving = false
        print("[TURBO] Done")
    end)
    task.delay(0.3, function() S.isMoving = false end)
end

