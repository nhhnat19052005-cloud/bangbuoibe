local function toggleMenu()
    STATE.UI_Open = not STATE.UI_Open
    local targetWidth = STATE.UI_Open and 320 or 260
    local targetHeight = STATE.UI_Open and 400 or 38
    local targetCorner = STATE.UI_Open and UDim.new(0, 16) or UDim.new(1, 0)
    local targetX = STATE.UI_Open and (0.5 - 160) or (0.5 - 130)
    
    TweenService:Create(mainWrapper, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(targetWidth, targetHeight),
        Position = UDim2.new(0.5, targetX, 0, 20)
    }):Play()
    TweenService:Create(mainCorner, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        CornerRadius = targetCorner
    }):Play()
    
    if STATE.UI_Open then
        statsLabel.Visible = false
        pillTurboBtn.Visible = false
        pillBackBtn.Visible = false
    else
        statsLabel.Visible = true
        pillTurboBtn.Visible = true
        pillBackBtn.Visible = true
    end
    header.Size = UDim2.fromOffset(targetWidth, 38)
end

