-- 2. ESP PLAYER LOGIC (IY STYLE + TOOL + RGB RAINBOW)
-- ==========================================
local function updateESP()
    local Camera = Workspace.CurrentCamera
    if not Camera then return end

    if not CONFIG.ESPPlayers then
        for _, d in pairs(ESP_Drawings) do
            if d.Name then d.Name.Visible = false end
        end
        for _, h in pairs(ESP_Highlights) do
            if h then h.Enabled = false end
        end
        return
    end

    local rainbowColor = Color3.fromHSV(tick() % 1, 1, 1)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if head and hum and hrp and hum.Health > 0 then
                local headScreen, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                
                local heldTool = char:FindFirstChildOfClass("Tool")
                local toolName = heldTool and heldTool.Name or "None"
                
                if not ESP_Drawings[player] then
                    ESP_Drawings[player] = {
                        Name = Drawing.new("Text")
                    }
                    ESP_Drawings[player].Name.Center = true
                    ESP_Drawings[player].Name.Outline = true
                    ESP_Drawings[player].Name.Size = 14
                    ESP_Drawings[player].Name.Font = 2
                    ESP_Drawings[player].Name.Color = Color3.fromRGB(255, 255, 255)
                end

                local d = ESP_Drawings[player]
                
                if headOnScreen then
                    d.Name.Visible = true
                    d.Name.Text = string.format("Name: %s | Tool: %s | Studs: %d", player.Name, toolName, math.floor(dist))
                    d.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 25)
                else
                    d.Name.Visible = false
                end

                -- Highlight RGB Rainbow
                if not ESP_Highlights[char] then
                    local h = Instance.new("Highlight")
                    h.Parent = char
                    h.Adornee = char
                    h.FillTransparency = 0.5
                    h.OutlineTransparency = 0
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    ESP_Highlights[char] = h
                end
                
                ESP_Highlights[char].Enabled = true
                ESP_Highlights[char].FillColor = rainbowColor
                ESP_Highlights[char].OutlineColor = rainbowColor
            else
                if ESP_Drawings[player] then ESP_Drawings[player].Name.Visible = false end
                if ESP_Highlights[char] then ESP_Highlights[char].Enabled = false end
            end
        end
    end
end

