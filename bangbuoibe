print("[ollie] Bước 5: Fix Lag Core")
local function isLagObject(obj)
    if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Trail") then return true end
    if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then return true end
    if obj:IsA("Decal") or obj:IsA("Texture") then return true end
    if obj:IsA("Sound") then return true end
    if obj:IsA("BasePart") and not obj.Anchored and not obj.CanCollide then
        local n = string.lower(obj.Name)
        if n:find("effect") or n:find("particle") or n:find("coin") or n:find("cash") or n:find("money") or n:find("sparkle") or n:find("rain") or n:find("snow") then
            return true
        end
    end
    return false
end

local function applyFixLag()
    if not S.fixLagEnabled then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isLagObject(obj) then
            pcall(function() obj:Destroy() end)
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if S.fixLagEnabled and isLagObject(obj) then
        pcall(function() obj:Destroy() end)
    end
end)

task.spawn(applyFixLag)

